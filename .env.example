# Gemini API keys are supplied by each user in the browser settings.
# Do not configure a shared server-side GEMINI_API_KEY.

# Preferred: use separate keys so browser referrer restrictions do not block server API requests.
# Browser key: restrict to deployed website referrers and the Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY="MY_GOOGLE_MAPS_BROWSER_API_KEY"
# Server key: keep server-side only; restrict to the Routes API and Air Quality API.
GOOGLE_MAPS_SERVER_API_KEY="MY_GOOGLE_MAPS_SERVER_API_KEY"
# Legacy fallback for both paths; prefer the separate keys above for production.
# GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"


