# Gemini API keys are supplied by each user in the browser settings.
# Do not configure a shared server-side GEMINI_API_KEY.

# Optional public MapLibre style URL. Defaults to OpenFreeMap's Liberty style.
# VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Optional server-side OSRM-compatible route service. Defaults to the public OSRM demo server.
# Use a self-hosted or contracted provider for production workloads.
# OSRM_ROUTING_URL="https://router.project-osrm.org"

